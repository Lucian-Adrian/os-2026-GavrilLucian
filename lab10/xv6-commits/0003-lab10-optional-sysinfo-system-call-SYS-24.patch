 }
+
+// Bytes on the free list (Lab 10, sysinfo).
+uint64
+freemem(void)
+{
+  uint64 n = 0;
+  acquire(&kmem.lock);
+  for (struct run *r = kmem.freelist; r; r = r->next)
+    n += PGSIZE;
+  release(&kmem.lock);
+  return n;
+}
diff --git a/kernel/proc.c b/kernel/proc.c
index b938cfd..8e1e6b5 100644
--- a/kernel/proc.c
+++ b/kernel/proc.c
@@ -702,3 +702,17 @@ procdump(void)
     printk("\n");
   }
 }
+
+// Number of process slots in use (Lab 10, sysinfo).
+uint64
+nproc(void)
+{
+  uint64 n = 0;
+  for (struct proc *p = proc; p < &proc[NPROC]; p++) {
+    acquire(&p->lock);
+    if (p->state != UNUSED)
+      n++;
+    release(&p->lock);
+  }
+  return n;
+}
