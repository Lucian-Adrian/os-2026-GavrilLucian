+  uint64 freemem;   // free memory, in bytes
+  uint64 nproc;     // processes not UNUSED
+};
diff --git a/kernel/sysproc.c b/kernel/sysproc.c
index f3b5d40..781e91d 100644
--- a/kernel/sysproc.c
+++ b/kernel/sysproc.c
@@ -5,6 +5,7 @@
 #include "memlayout.h"
 #include "spinlock.h"
 #include "proc.h"
+#include "sysinfo.h"
 #include "vm.h"
 
 uint64
@@ -119,3 +120,18 @@ sys_trace(void)
   myproc()->trace_mask = mask;
   return 0;
 }
+
+uint64
+sys_sysinfo(void)
+{
+  uint64 addr;
+  struct sysinfo info;
+  struct proc *p = myproc();
+
+  argaddr(0, &addr);
+  info.freemem = freemem();
+  info.nproc = nproc();
+  if (copyout(p->pagetable, p->sz, addr, (char *)&info, sizeof(info)) < 0)
+    return -1;
+  return 0;
+}
diff --git a/user/sysinfo.c b/user/sysinfo.c
new file mode 100644
index 0000000..48e4d1d
--- /dev/null
+++ b/user/sysinfo.c
@@ -0,0 +1,35 @@
+#include "kernel/types.h"
+#include "kernel/sysinfo.h"
+#include "user/user.h"
+
+// Print free memory and process count, then show that both react:
+// a fork adds a process, an sbrk takes pages from the free list.
+static void
+show(char *when)
+{
+  struct sysinfo info;
+  if (sysinfo(&info) < 0) {
+    fprintf(2, "sysinfo: failed\n");
+    exit(1);
+  }
+  printf("%s: free %ld bytes (%ld pages), %ld processes\n", when, info.freemem, info.freemem / 4096, info.nproc);
+}
+
+int
+main(void)
+{
+  show("start      ");
+  int pid = fork();
+  if (pid == 0) {
+    pause(10);
+    exit(0);
+  }
+  show("after fork ");
+  sbrk(40960);
+  show("after sbrk ");
+  wait(0);
+  show("after wait ");
+  if (sysinfo((struct sysinfo *)0xffffffffff) < 0)
+    printf("bad pointer: sysinfo returned -1\n");
+  exit(0);
+}
