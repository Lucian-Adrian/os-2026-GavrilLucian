   pid = np->pid;
 
@@ -701,3 +702,17 @@ procdump(void)
     printk("\n");
   }
 }
+
+// Number of process slots in use (Lab 10, sysinfo).
+uint64
+nproc(void)
+{
+  uint64 n = 0;
+  for (struct proc *p = proc; p < &proc[NPROC]; p++) {
+    acquire(&p->lock);
+    if (p->state != UNUSED)
+      n++;
+    release(&p->lock);
+  }
+  return n;
+}
