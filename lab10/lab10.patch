     memset((char *)r, 5, PGSIZE); // fill with junk
   return (void *)r;
 }
+
+// Bytes on the free list (Lab 10, sysinfo).
+uint64
+freemem(void)
+{
+  uint64 n = 0;
+  acquire(&kmem.lock);
+  for (struct run *r = kmem.freelist; r; r = r->next)
+    n += PGSIZE;
+  release(&kmem.lock);
+  return n;
+}
