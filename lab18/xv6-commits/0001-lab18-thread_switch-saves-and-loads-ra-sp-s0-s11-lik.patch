From 39043840f282ca5db0a2b2e60bf6169101c6e2ce Mon Sep 17 00:00:00 2001
From: Gavril Lucian-Adrian <189462022+Lucian-Adrian@users.noreply.github.com>
Date: Wed, 25 Nov 2026 12:14:22 +0200
Subject: [PATCH 1/3] lab18: thread_switch saves and loads ra, sp, s0-s11 (like
 kernel swtch)

---
 user/uthread_switch.S | 47 +++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 47 insertions(+)
 create mode 100644 user/uthread_switch.S

diff --git a/user/uthread_switch.S b/user/uthread_switch.S
new file mode 100644
index 0000000..041145f
--- /dev/null
+++ b/user/uthread_switch.S
@@ -0,0 +1,47 @@
+	.text
+
+/*
+ * void thread_switch(struct context *old, struct context *new);
+ *
+ * Same shape as the kernel's swtch (kernel/swtch.S), but in user space.
+ * a0 = &old->ctx, a1 = &new->ctx.
+ * Save the callee-saved registers of the running thread into *old,
+ * load the ones of the next thread from *new, then "ret":
+ * ret jumps to the ra just loaded, so execution continues in the next thread.
+ * The caller-saved registers (a0-a7, t0-t6) need no saving: the C caller of
+ * thread_switch already assumes a function call may destroy them.
+ */
+
+	.globl thread_switch
+thread_switch:
+	sd ra, 0(a0)
+	sd sp, 8(a0)
+	sd s0, 16(a0)
+	sd s1, 24(a0)
+	sd s2, 32(a0)
+	sd s3, 40(a0)
+	sd s4, 48(a0)
+	sd s5, 56(a0)
+	sd s6, 64(a0)
+	sd s7, 72(a0)
+	sd s8, 80(a0)
+	sd s9, 88(a0)
+	sd s10, 96(a0)
+	sd s11, 104(a0)
+
+	ld ra, 0(a1)
+	ld sp, 8(a1)
+	ld s0, 16(a1)
+	ld s1, 24(a1)
+	ld s2, 32(a1)
+	ld s3, 40(a1)
+	ld s4, 48(a1)
+	ld s5, 56(a1)
+	ld s6, 64(a1)
+	ld s7, 72(a1)
+	ld s8, 80(a1)
+	ld s9, 88(a1)
+	ld s10, 96(a1)
+	ld s11, 104(a1)
+
+	ret    /* return to the next thread: pc = ra */
-- 
