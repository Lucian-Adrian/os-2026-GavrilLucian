From 2bd6a4a30acceafc2faa86b2ab8ab2b6fb7ebeda Mon Sep 17 00:00:00 2001
From: Gavril Lucian-Adrian <189462022+Lucian-Adrian@users.noreply.github.com>
Date: Wed, 25 Nov 2026 12:14:22 +0200
Subject: [PATCH 2/3] lab18: uthread with context, thread_create sets ra and
 sp, schedule calls thread_switch

---
 user/uthread.c | 182 +++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 182 insertions(+)
 create mode 100644 user/uthread.c

diff --git a/user/uthread.c b/user/uthread.c
new file mode 100644
index 0000000..a17940e
--- /dev/null
+++ b/user/uthread.c
@@ -0,0 +1,182 @@
+#include "kernel/types.h"
+#include "user/user.h"
+
+/* Possible states of a thread: */
+#define FREE        0x0
+#define RUNNING     0x1
+#define RUNNABLE    0x2
+
+#define STACK_SIZE  8192
+#define MAX_THREAD  4
+
+/* the registers a thread must keep across a switch (callee-saved).
+ * The order and the offsets must match user/uthread_switch.S:
+ * ra 0, sp 8, s0 16, s1 24, ... s11 104. */
+struct context {
+  uint64 ra;    /* where thread_switch returns to: the thread's next instruction */
+  uint64 sp;    /* the thread's own stack */
+
+  /* callee-saved */
+  uint64 s0;
+  uint64 s1;
+  uint64 s2;
+  uint64 s3;
+  uint64 s4;
+  uint64 s5;
+  uint64 s6;
+  uint64 s7;
+  uint64 s8;
+  uint64 s9;
+  uint64 s10;
+  uint64 s11;
+};
+
+struct thread {
+  struct context ctx;                                  /* saved registers */
+  char       stack[STACK_SIZE] __attribute__((aligned(16))); /* the thread's own stack */
+  int        state;                                    /* FREE, RUNNING, RUNNABLE */
+};
+struct thread all_thread[MAX_THREAD];
+struct thread *current_thread;
+extern void thread_switch(struct context *old, struct context *new);
+
+void
+thread_init(void)
+{
+  /* main() is thread 0: it will run first */
+  current_thread = &all_thread[0];
+  current_thread->state = RUNNING;
+}
+
+void
+thread_schedule(void)
+{
+  struct thread *t, *next_thread;
+
+  /* find another runnable thread, round robin */
+  next_thread = 0;
+  t = current_thread + 1;
+  for(int i = 0; i < MAX_THREAD; i++){
+    if(t >= all_thread + MAX_THREAD)
+      t = all_thread;
+    if(t->state == RUNNABLE) {
+      next_thread = t;
+      break;
+    }
+    t = t + 1;
+  }
+
+  if (next_thread == 0) {
+    printf("thread_schedule: no runnable threads\n");
+    exit(-1);
+  }
+
+  if (current_thread != next_thread) {         /* switch threads? */
+    struct thread *old = current_thread;
+    next_thread->state = RUNNING;
+    current_thread = next_thread;
+    /* saves old's ra/sp/s0..s11, loads next's, and "returns" into next.
+     * For old, this call returns only when another thread switches back to it. */
+    thread_switch(&old->ctx, &next_thread->ctx);
+  }
+}
+
+void
+thread_create(void (*func)())
+{
+  struct thread *t;
+
+  for (t = all_thread; t < all_thread + MAX_THREAD; t++) {
+    if (t->state == FREE) break;
+  }
+  t->state = RUNNABLE;
+  /* the first thread_switch to t loads these two and executes "ret":
+   * ret jumps to ra, so the thread starts at the top of func,
+   * and it runs on its own stack, which grows down from the END of t->stack. */
+  t->ctx.ra = (uint64)func;
+  t->ctx.sp = (uint64)(t->stack + STACK_SIZE);
+}
+
+void
+thread_yield(void)
+{
+  current_thread->state = RUNNABLE;
+  thread_schedule();
+}
+
+volatile int a_started, b_started, c_started;
+volatile int a_n, b_n, c_n;
+
+void
+thread_a(void)
+{
+  int i;
+  printf("thread_a started\n");
+  a_started = 1;
+  while(b_started == 0 || c_started == 0)
+    thread_yield();
+
+  for (i = 0; i < 100; i++) {
+    printf("thread_a %d\n", i);
+    a_n += 1;
+    thread_yield();
+  }
+  printf("thread_a: exit after %d\n", a_n);
+
+  current_thread->state = FREE;
+  thread_schedule();
+}
+
+void
+thread_b(void)
+{
+  int i;
+  printf("thread_b started\n");
+  b_started = 1;
+  while(a_started == 0 || c_started == 0)
+    thread_yield();
+
+  for (i = 0; i < 100; i++) {
+    printf("thread_b %d\n", i);
+    b_n += 1;
+    thread_yield();
+  }
+  printf("thread_b: exit after %d\n", b_n);
+
+  current_thread->state = FREE;
+  thread_schedule();
+}
+
+void
+thread_c(void)
+{
+  int i;
+  printf("thread_c started\n");
+  c_started = 1;
+  while(a_started == 0 || b_started == 0)
+    thread_yield();
+
+  for (i = 0; i < 100; i++) {
+    printf("thread_c %d\n", i);
+    c_n += 1;
+    thread_yield();
+  }
+  printf("thread_c: exit after %d\n", c_n);
+
+  current_thread->state = FREE;
+  thread_schedule();
+}
+
+int
+main(int argc, char *argv[])
+{
+  a_started = b_started = c_started = 0;
+  a_n = b_n = c_n = 0;
+  thread_init();
+  thread_create(thread_a);
+  thread_create(thread_b);
+  thread_create(thread_c);
+  current_thread->state = FREE;      /* main is done: only a, b, c remain */
+  thread_schedule();
+  exit(0);
+}
-- 
