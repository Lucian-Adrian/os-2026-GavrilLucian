diff --git a/user/mix.c b/user/mix.c
new file mode 100644
index 0000000..bb9aa30
--- /dev/null
+++ b/user/mix.c
@@ -0,0 +1,32 @@
+// mix.c: two processes print five lines each, one letter per write().
+//   mix        no lock: the letters of the two processes can mix
+//   mix lock   semaphore 3 used as a lock: every line stays whole
+#include "kernel/types.h"
+#include "user/user.h"
+
+void
+lines(char *s, int uselock)
+{
+  for (int k = 0; k < 5; k++) {
+    if (uselock)
+      sem_down(3);
+    for (char *p = s; *p; p++)
+      write(1, p, 1);
+    if (uselock)
+      sem_up(3);
+  }
+}
+
+int
+main(int argc, char *argv[])
+{
+  int uselock = (argc > 1);
+  sem_init(3, 1);
+  if (fork() == 0) {
+    lines("bbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\n", uselock);
+    exit(0);
+  }
+  lines("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\n", uselock);
+  wait(0);
+  exit(0);
+}
diff --git a/user/semtest.c b/user/semtest.c
new file mode 100644
index 0000000..0e2f1f8
--- /dev/null
+++ b/user/semtest.c
@@ -0,0 +1,39 @@
+// semtest.c: two tests for the kernel semaphores (Lab 13).
+#include "kernel/types.h"
+#include "user/user.h"
+
+int
+main(void)
+{
+  // Test 1: order. Semaphore 0 starts at 0, so the child must wait.
+  sem_init(0, 0);
+  if (fork() == 0) {
+    sem_down(0);
+    printf("child: I ran after the parent\n");
+    exit(0);
+  }
+  pause(10);
+  printf("parent: done, I let the child go\n");
+  sem_up(0);
+  wait(0);
+
+  // Test 2: ping-pong. Semaphore 1 = ping's turn, semaphore 2 = pong's turn.
+  sem_init(1, 1);
+  sem_init(2, 0);
+  if (fork() == 0) {
+    for (int i = 1; i <= 3; i++) {
+      sem_down(2);
+      printf("  pong %d\n", i);
+      sem_up(1);
+    }
+    exit(0);
+  }
+  for (int i = 1; i <= 3; i++) {
+    sem_down(1);
+    printf("ping %d\n", i);
+    sem_up(2);
+  }
+  wait(0);
+  printf("semtest: OK\n");
+  exit(0);
+}
diff --git a/user/sysinfo.c b/user/sysinfo.c
new file mode 100644
index 0000000..48e4d1d
--- /dev/null
+++ b/user/sysinfo.c
@@ -0,0 +1,35 @@
+#include "kernel/types.h"
+#include "kernel/sysinfo.h"
+#include "user/user.h"
+
+// Print free memory and process count, then show that both react:
+// a fork adds a process, an sbrk takes pages from the free list.
+static void
+show(char *when)
+{
+  struct sysinfo info;
+  if (sysinfo(&info) < 0) {
+    fprintf(2, "sysinfo: failed\n");
+    exit(1);
+  }
+  printf("%s: free %ld bytes (%ld pages), %ld processes\n", when, info.freemem, info.freemem / 4096, info.nproc);
+}
+
+int
+main(void)
+{
+  show("start      ");
+  int pid = fork();
+  if (pid == 0) {
+    pause(10);
+    exit(0);
+  }
+  show("after fork ");
+  sbrk(40960);
+  show("after sbrk ");
+  wait(0);
+  show("after wait ");
+  if (sysinfo((struct sysinfo *)0xffffffffff) < 0)
+    printf("bad pointer: sysinfo returned -1\n");
+  exit(0);
+}
diff --git a/user/trace.c b/user/trace.c
new file mode 100644
index 0000000..5c7a5df
--- /dev/null
+++ b/user/trace.c
@@ -0,0 +1,19 @@
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+
+int
+main(int argc, char *argv[])
+{
+  if (argc < 3) {
+    fprintf(2, "usage: trace mask command [args...]\n");
+    exit(1);
+  }
+  if (trace(atoi(argv[1])) < 0) {
+    fprintf(2, "trace: failed\n");
+    exit(1);
+  }
+  exec(argv[2], argv + 2);
+  fprintf(2, "trace: exec %s failed\n", argv[2]);
+  exit(1);
+}
diff --git a/user/trydown.c b/user/trydown.c
new file mode 100644
index 0000000..bb65e92
--- /dev/null
+++ b/user/trydown.c
@@ -0,0 +1,16 @@
+// trydown.c: the optional sem_trydown (Lab 13). Semaphore 4 starts at 2,
+// so the first two calls take a unit and the third returns -1 at once.
+#include "kernel/types.h"
+#include "user/user.h"
+
+int
+main(void)
+{
+  sem_init(4, 2);
+  for (int i = 1; i <= 3; i++)
+    printf("try %d: sem_trydown(4) = %d\n", i, sem_trydown(4));
+  sem_up(4);
+  printf("after sem_up(4): sem_trydown(4) = %d\n", sem_trydown(4));
+  printf("bad id: sem_trydown(9) = %d, sem_down(-1) = %d\n", sem_trydown(9), sem_down(-1));
+  exit(0);
+}
