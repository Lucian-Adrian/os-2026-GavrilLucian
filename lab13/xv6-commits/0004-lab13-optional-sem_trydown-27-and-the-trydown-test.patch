diff --git a/kernel/sem.c b/kernel/sem.c
index b1d3f44..077134b 100644
--- a/kernel/sem.c
+++ b/kernel/sem.c
@@ -75,3 +75,24 @@ sys_sem_up(void)
   release(&s->lock);
   return 0;
 }
+
+// sem_trydown(id) (optional): like sem_down, but never sleeps.
+// Returns 0 if it took a unit, -1 at once if the value was 0.
+uint64
+sys_sem_trydown(void)
+{
+  int id;
+  argint(0, &id);
+  if (id < 0 || id >= NSEM)
+    return -1;
+  struct sem *s = &sems[id];
+
+  acquire(&s->lock);
+  if (s->value == 0) {
+    release(&s->lock);
+    return -1;
+  }
+  s->value--;
+  release(&s->lock);
+  return 0;
+}
